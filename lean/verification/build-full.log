@PaperReliability.likelihood_regional_error_bounds : ∀ {X : Type u_1} {ι : Type u_2} [inst : Fintype X] [Nonempty X]
  [inst_2 : Fintype ι] (error : X → ℝ) (tangent : X → ι → ℝ) (singular residual : ι → ℝ) {precision noise : ℝ},
  0 < precision →
    0 < noise →
      have shift := fun x => PaperReliability.predictiveShift (tangent x) singular residual precision;
      have width := fun x =>
        √(noise * PaperReliability.modalVariance (fun i => singular i ^ 2) (fun i => tangent x i ^ 2) precision);
      have c := √(PaperReliability.likelihoodEnergy singular residual precision / noise);
      have B :=
        min (c * PaperReliability.regionalRMS width)
          (∑ i,
            |PaperReliability.likelihoodShift singular residual precision i| *
              PaperReliability.regionalRMS fun x => tangent x i);
      (max 0 (PaperReliability.regionalRMS error - B) ≤ PaperReliability.regionalRMS fun x => error x + shift x) ∧
        (PaperReliability.regionalRMS fun x => error x + shift x) ≤ PaperReliability.regionalRMS error + B
@PaperReliability.likelihood_centre_coverage : ∀ {X : Type u_1} {ι : Type u_2} [inst : Fintype X] [Nonempty X]
  [inst_2 : Fintype ι] (error : X → ℝ) (tangent : X → ι → ℝ) (singular residual : ι → ℝ)
  {precision noise threshold : ℝ},
  0 < precision →
    0 < noise →
      √(PaperReliability.likelihoodEnergy singular residual precision / noise) ≤ threshold →
        have shift := fun x => PaperReliability.predictiveShift (tangent x) singular residual precision;
        have width := fun x =>
          √(noise * PaperReliability.modalVariance (fun i => singular i ^ 2) (fun i => tangent x i ^ 2) precision);
        have c := √(PaperReliability.likelihoodEnergy singular residual precision / noise);
        PaperReliability.centreCoverage error width (threshold - c) ≤
            PaperReliability.centreCoverage (fun x => error x + shift x) width threshold ∧
          PaperReliability.centreCoverage (fun x => error x + shift x) width threshold ≤
            PaperReliability.centreCoverage error width (threshold + c)
